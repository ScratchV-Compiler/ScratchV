# W1 probe outputs — regenerated by probes/w1_tiny_transformer/run.py.
# Everything here is disposable *except* the model, which is committed through
# Git LFS (see .gitattributes) so downstream work can fetch the artifact
# without re-running the probe. Note the trailing `/*`: excluding the directory
# itself would make the negation below impossible.
probes/w1_tiny_transformer/out/*
!probes/w1_tiny_transformer/out/tiny_transformer_2l.onnx
