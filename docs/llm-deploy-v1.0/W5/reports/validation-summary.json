 "units": {
  "time": "带 _s 的字段单位为秒；wall 是经过时间，CPU 是线程累计处理器时间，不能互相相加。",
  "memory": "带 _bytes 的字段单位为 byte；RSS 是采样观测值，不是内存硬上限；GiB 换算为 bytes / 1073741824。",
  "cpu_percent": "QEMU CPU / QEMU process wall * 100；100% 表示一个逻辑 CPU。",
  "numerical": "max_abs 为所比较 logits 元素最大绝对误差；*_frozen_selected_abs 为选中 token logit 相对冻结参考的绝对误差。",
  "step": "numeric_steps 的 step 是各用例内部前向序号，从 0 到 7；case 与 step 共同定位一条记录。"
 },
 "measurement_definitions": {
  "generation_wall_s": "单条用例生成调用经过时间，包含逐 token QEMU 调用与 Host 参考数值检查，不是编译耗时。",
  "uart_completion_wall_s": "QEMU launch through host validation of the UART completion frame",
  "qemu_process_wall_s": "QEMU 子进程寿命；包括 UART 完成后的停止、输出转储与退出清理。",
  "runner_elapsed_s": "运行器调用总耗时，包含权重传输、QEMU、完成后检查和清理；不等同于纯算子执行。",
  "measurement_total_wall_s": "外层测量全过程，包含准备、ORT 参考和数值检查。",
  "qemu_cpu_s": "每步 RUSAGE_CHILDREN CPU 差值由测量工具归入 QEMU，三例汇总取 cases[*].qemu_cpu；不使用包含其他子进程的 total_child_cpu。",
  "host_cpu_s": "Host 进程 CPU，含 ORT 及验证开销；case 与整个测量的范围分别记录。",
  "rss": "Host+live descendants simultaneous RSS sum；共享页可能重复计数。各进程独立峰值不能相加当作同一时刻峰值。",
  "cache": "复用相同 ELF/bundle；每次前向启动新 QEMU，未清空宿主页缓存，不能作为冷缓存结果。",
  "performance_comparison": "这些数据没有单核完整生成对照，不据此计算 W5 1/4 核生成加速比。",
  "inference_program_elapsed_s": "推理程序开始准备至程序内部计时结束，取对应 run/report.json 的 elapsed_seconds；包含当次实际发生的构建、自检、参考程序初始化、生成与校验及程序内收尾，不包含此前构建、Docker 镜像准备或容器启动。",
  "compile_wall_s": "本次 C 程序编译与链接经过时间，取新构建的 build.compile_seconds；包含编译器启动、C 编译、汇编、链接、日志保存和 ELF 检查，不含此前模型解析、C 源码生成及权重打包。复用构建时为 null，不能计入旧构建记录中的编译时间。",
  "deployment_elapsed_s": "保留的历史字段名；容器记录中与 inference_program_elapsed_s 同取 run/report.json.elapsed_seconds，并非 Docker 镜像准备到退出的外层全过程。"
 },
